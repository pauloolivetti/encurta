# Copie este arquivo para .env e ajuste os valores (o .env não vai para o git)

# Senha do banco PostgreSQL (obrigatória)
POSTGRES_PASSWORD=troque-esta-senha

# Porta do site no seu computador (padrão 8080)
WEB_PORT=8080

# Opcional: endereço público usado nos links curtos.
# Se ficar em branco, usa o endereço pelo qual o site foi aberto.
# BASE_URL=https://encurta.exemplo.com
